# Copy to .env for local development (optional — defaults work without this file)
DEBUG=True
SECRET_KEY=your-local-secret-key

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_NAME=django_sample
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Production (Render / Railway provide DATABASE_URL automatically)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Production — set your app hostname(s), comma-separated
# ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
